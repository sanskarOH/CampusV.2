# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/college_events?schema=public"

# JWT signing secret — use a long random string in production (min 32 chars)
JWT_SECRET="change-me-to-a-long-random-secret-minimum-32-characters"

# Cookie name for HTTP-only auth token
AUTH_COOKIE_NAME="cms_access_token"

# Node environment
NODE_ENV="development"

# Optional: base URL for emails (mock)
APP_URL="http://localhost:3000"

# Rate limit: max requests per window per IP (API routes)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
